---
layout: layouts/example.njk
title: Proxy profile card
figmaLink:
vueLink:
arguments: card-group
---

{% from "nhsapp/components/card/macro.njk" import nhsappCardGroup %}
{% from "icon/macro.njk" import nhsappIcon %}

{% set switchProfileHtml %}
  <span class="nhsapp-icon-text">
    {{ nhsappIcon("switchProfile", "nhsapp-icon--text-colour nhsapp-icon--32") }}
    <span>Family and carer access<br><span class="nhsuk-u-font-weight-normal">Switch profile</span></span>
  </span>
{% endset %}

{{ nhsappCardGroup({
  stacked: true,
  classes: "nhsapp-cards--proxy",
  isListItem: false,
  cards: [
    {
      aboveContent: { html: '<p class="nhsuk-u-font-weight-bold nhsuk-u-margin-bottom-1">Acting for</p>' },
      heading: { text: "Laura Patel", level: 2, classes: "nhsuk-u-font-size-36" },
      description: {
        html: '<p class="nhsuk-u-margin-top-2 nhsuk-u-margin-bottom-0"><strong>Date of birth:</strong> 22 July 1952</p>'
      }
    },
    {
      heading: { html: switchProfileHtml },
      href: "#"
    }
  ]
}) }}
