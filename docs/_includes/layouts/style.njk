{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% block beforeContent %}
  {% if title === "Styles" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/styles",
      text: "Styles"
    }) }}
  {% endif %}
{% endblock %}

{% set sidebar %}
  {{ appSideNavigation({
    label: 'Styles',
    currentPath: page.url,
    sections: [
      {
        heading: {
          text: 'Styles'
        },
        items: collections.style | sort(attribute="data.title")
      }
    ]
  }) }}
{% endset %}

{% block content %}
  {% if tags and "deprecated" in tags %}
    {{ tag({
      text: "Deprecated",
      colour: "red",
      classes: "nhsuk-u-margin-bottom-4"
    }) }}
  {% endif %}

  {{ heading({
    text: title,
    level: 1,
    size: "xl",
    caption: { text: "Styles" } if tags and "style" in tags else none,
    classes: "nhsuk-u-margin-bottom-5"
  }) }}
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and "style" in tags %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}

{% endblock %}
