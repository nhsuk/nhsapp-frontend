---
section: android
---

{% extends "./sidebar.njk" %}
{% from 'nhsapp/components/tag/macro.njk' import nhsappTag %}

{% if page.url == '/android/' or (tags and 'android' in tags) %}
  {% set sidebarLabel = 'Get started' %}
  {% set sidebarItems = collections.android | sort(attribute="data.order") %}
{% elif page.url == '/android/styles/' or (tags and 'androidStyles' in tags) %}
  {% set sidebarLabel = 'Styles' %}
  {% set sidebarItems = collections.androidStyles | sort(attribute="data.title") %}
{% endif %}

{% block sidebar %}
  {% if sidebarLabel and sidebarItems %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1 nhsuk-u-secondary-text-colour">{{ sidebarLabel }}</h3>
  {{ sectionNavigation({
    ariaLabel: sidebarLabel,
    direction: "vertical",
    small: true,
    items: sidebarItems | toSectionNavigationItems(page.url)
  }) }}
  {% endif %}
{% endblock %}

{% block content %}
  {{ nhsappTag({
    text: 'Work in progress',
    classes: 'nhsapp-tag--blue nhsuk-u-margin-bottom-4'
  })}}

  {% if section == "android" %}
    <span class="nhsuk-caption-xl">Android</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if section == "android" %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
