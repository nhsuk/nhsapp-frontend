{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% block beforeContent %}
  {% if title === "Android" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/android",
      text: "Android"
    }) }}
  {% endif %}
{% endblock %}

{% set sidebar %}
  {{ appSideNavigation({
    currentPath: page.url,
    sections: [
      {
        heading: {
          text: 'Get started'
        },
        items: collections.android | sort(attribute="data.order")
      },
      {
        heading: {
          text: 'Styles'
        },
        items: collections.androidStyles | sort(attribute="data.title")
      }
    ]
  }) }}
{% endset %}

{% block content %}
  {{ nhsappTag({
    text: 'Work in progress',
    classes: 'nhsapp-tag--blue nhsuk-u-margin-bottom-4'
  })}}

  {{ heading({
    text: title,
    level: 1,
    size: "xl",
    caption: { text: "Android" },
    classes: "nhsuk-u-margin-bottom-5"
  }) }}
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and "android" in tags %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
