---
section: android
---

{% extends "./sidebar.njk" %}
{% from 'nhsapp/components/tag/macro.njk' import nhsappTag %}

{% block beforeContent %}
  {% if title === "Android" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/android",
      text: "Android"
    }) }}
  {% endif %}
{% endblock %}

{% block sidebar %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Get started</h3>
  {{ sectionNavigation({
    ariaLabel: "Get started",
    direction: "vertical",
    small: true,
    items: collections.android | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Styles</h3>
  {{ sectionNavigation({
    ariaLabel: "Styles",
    direction: "vertical",
    small: true,
    items: collections.androidStyles | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}
{% endblock %}

{% block content %}
  {{ nhsappTag({
    text: 'Work in progress',
    classes: 'nhsapp-tag--blue nhsuk-u-margin-bottom-4'
  })}}

  {% if section == "android" %}
    <span class="nhsuk-caption-xl">Android</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if section == "android" %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
