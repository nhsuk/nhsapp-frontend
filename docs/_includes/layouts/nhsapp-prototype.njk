{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% block beforeContent %}
  {% if title === "Get started" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        },
        {
          href: "/get-started",
          text: "Get started"
        }
      ],
      href: "/get-started/nhsapp-prototype",
      text: "NHS App prototype"
    }) }}
  {% endif %}
{% endblock %}

{% set sidebar %}
  {{ appSideNavigation({
    label: 'NHS App prototype',
    currentPath: page.url,
    sections: [
      {
        heading: {
          text: 'NHS App prototype'
        },
        items: collections.nhsappPrototype | sort(attribute="data.order")
      }
    ]
  }) }}
{% endset %}

{% block content %}
  {{ heading({
    text: title,
    level: 1,
    size: "xl",
    caption: { text: "NHS App prototype" },
    classes: "nhsuk-u-margin-bottom-5"
  }) }}
  {{ content | safe }}
  
{% endblock %}
