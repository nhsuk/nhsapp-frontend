{% set isComponent = subsection == "Components" %}
{% set isStyle = subsection == "Styles" %}
{% set isHelpPattern = theme == "Help users to" %}
{% set feedbackSubject = "this pattern" %}

{% if isComponent %}
  {% set feedbackSubject = "this component" %}
{% elif isStyle %}
  {% set feedbackSubject = "these styles" %}
{% endif %}

{% if isComponent or isStyle or isHelpPattern %}
  <h2>Help improve {{ feedbackSubject }}</h2>

  <p>The NHS App design system team would like to hear:</p>

  <ul>
    <li>how you have used {{ feedbackSubject }} in your service</li>
    <li>any feedback you have about its usage, for example accessibility or ideas for improvement</li>
  </ul>

  <p>Add these comments to the <a href="https://github.com/nhsuk/nhsapp-frontend/issues/{{ backlogID }}">'{{ title }}' discussion on GitHub</a>.</p>

{% endif %}
