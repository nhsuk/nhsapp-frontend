{% extends "nhsuk/template-with-imports.njk" %}

{% from "icon/macro.njk" import nhsappIcon %}
{% from "nhsuk/components/section-navigation/macro.njk" import sectionNavigation %}

{% block pageTitle -%}
  {% if title %}{{ title }} - {% endif %}NHS App design system
{%- endblock %}

{% block head %}
  <link href="/assets/css/app.css" rel="stylesheet" />

  <meta property="og:url" content="https://design-system.nhsapp.service.nhs.uk/"/>
  <meta property="og:site_name" content="nhs.uk"/>
  <meta property="og:title" content="NHS App design system"/>
  <meta property="og:description" content="Design and build accessible services for the NHS App. Use the NHS App design system to learn from the work and experiences of others."/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="en_GB"/>
  <meta property="og:image" content="https://design-system.nhsapp.service.nhs.uk/assets/images/open-graph.png"/>

{% endblock %}

{% block header %}
  {{ header({
    service: {
      text: 'App design system<span class="nhsuk-u-visually-hidden"> homepage</span>' | safe,
      href: '/'
    },
    navigation: {
      items: [
        {
          href: '/',
          text: 'Home',
          active: page and page.url == '/'
        },
        {
          href: '/get-started/',
          text: 'Web',
          active: section == 'Web'
        },
        {
          href: '/ios/',
          text: 'iOS',
          active: section == 'iOS'
        },
        {
          href: '/android/',
          text: 'Android',
          active: section == 'Android'
        },
        {
          href: '/community/',
          text: 'Community',
          active: section == 'Community'
        }
      ]
    }
  }) }}

  {% set sectionNavItems = collections.all | getSubsectionNavigationItems(section, subsection) %}

  {% if sectionNavItems and sectionNavItems.length > 1 %}
    <div class="nhsuk-width-container">
      {{ sectionNavigation({
        ariaLabel: 'Section navigation',
        direction: 'horizontal',
        small: true,
        items: sectionNavItems
      }) }}
    </div>
  {% endif %}
{% endblock %}

{% block content %}
  {{ content | safe }}
{% endblock %}

{% block footer %}
  {{ footer({
    meta: {
      items: [
        {
          href: '/community/help-and-feedback/',
          text: 'Help and feedback'
        },
        {
          href: 'https://github.com/nhsuk/nhsapp-frontend',
          text: 'Code on Github'
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/js/app.js"></script>
  <script type="module" src="/nhsuk-frontend/dist/nhsuk/nhsuk-frontend.min.js"></script>
  <script type="module">
    import { initAll } from '/nhsuk-frontend/dist/nhsuk/nhsuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
