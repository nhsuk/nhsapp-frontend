---
section: ios
---

{% extends "./sidebar.njk" %}
{% from 'nhsapp/components/tag/macro.njk' import nhsappTag %}

{% if page.url == '/ios/' or (tags and 'ios' in tags) %}
  {% set sidebarLabel = 'Get started' %}
  {% set sidebarItems = collections.ios %}
{% elif page.url == '/ios/styles/' or (tags and 'iosStyles' in tags) %}
  {% set sidebarLabel = 'Styles' %}
  {% set sidebarItems = collections.iosStyles %}
{% elif page.url == '/ios/components/' or (tags and 'iosComponents' in tags) %}
  {% set sidebarLabel = 'Components' %}
  {% set sidebarItems = collections.iosComponents %}
{% elif page.url == '/ios/layouts/' or (tags and 'iosLayouts' in tags) %}
  {% set sidebarLabel = 'Layouts' %}
  {% set sidebarItems = collections.iosLayouts %}
{% endif %}

{% block beforeContent %}
  {% if title === "iOS" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/ios",
      text: "iOS"
    }) }}
  {% endif %}
{% endblock %}

{% block sidebar %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Get started</h3>
  {{ sectionNavigation({
    ariaLabel: "Get started",
    direction: "vertical",
    small: true,
    items: collections.ios | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Styles</h3>
  {{ sectionNavigation({
    ariaLabel: "Styles",
    direction: "vertical",
    small: true,
    items: collections.iosStyles | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Components</h3>
  {{ sectionNavigation({
    ariaLabel: "Components",
    direction: "vertical",
    small: true,
    items: collections.iosComponents | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Layouts</h3>
  {{ sectionNavigation({
    ariaLabel: "Layouts",
    direction: "vertical",
    small: true,
    items: collections.iosLayouts | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}
{% endblock %}

{% block content %}
    {{ nhsappTag({
    text: 'Work in progress',
    classes: 'nhsapp-tag--blue nhsuk-u-margin-bottom-4'
    })}}

  {% if section == "ios" %}
    <span class="nhsuk-caption-xl">iOS</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if section == "ios" %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
