---
section: ios
---

{% extends "./sidebar.njk" %}
{% from 'nhsapp/components/tag/macro.njk' import nhsappTag %}

{% if page.url == '/ios/' or (tags and 'ios' in tags) %}
  {% set sidebarLabel = 'Get started' %}
  {% set sidebarItems = collections.ios | sort(attribute="data.order") %}
{% elif page.url == '/ios/styles/' or (tags and 'iosStyles' in tags) %}
  {% set sidebarLabel = 'Styles' %}
  {% set sidebarItems = collections.iosStyles | sort(attribute="data.title") %}
{% elif page.url == '/ios/components/' or (tags and 'iosComponents' in tags) %}
  {% set sidebarLabel = 'Components' %}
  {% set sidebarItems = collections.iosComponents | sort(attribute="data.title") %}
{% elif page.url == '/ios/layouts/' or (tags and 'iosLayouts' in tags) %}
  {% set sidebarLabel = 'Layouts' %}
  {% set sidebarItems = collections.iosLayouts | sort(attribute="data.title") %}
{% endif %}

{% block sidebar %}
  {% if sidebarLabel and sidebarItems %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">{{ sidebarLabel }}</h3>
  {{ sectionNavigation({
    ariaLabel: sidebarLabel,
    direction: "vertical",
    small: true,
    items: sidebarItems | toSectionNavigationItems(page.url)
  }) }}
  {% endif %}
{% endblock %}

{% block content %}
    {{ nhsappTag({
    text: 'Work in progress',
    classes: 'nhsapp-tag--blue nhsuk-u-margin-bottom-4'
    })}}

  {% if section == "ios" %}
    <span class="nhsuk-caption-xl">iOS</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if section == "ios" %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
