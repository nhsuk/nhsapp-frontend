---
section: web
---

{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% set sidebar %}
  {{ appSideNavigation({
    label: 'Components',
    currentPath: page.url,
    sections: [
      {
        items: collections.component | sort(attribute="data.title")
      },
      {
        heading: {
          text: 'Archived'
        },
        items: collections.archivedComponent | sort(attribute="data.title")
      }
    ]
  }) }}
{% endset %}

{% block content %}
   {% if tags and ("component" in tags or "archivedComponent" in tags) %}
    <span class="nhsuk-caption-xl">Components</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and "component" in tags %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}

{% endblock %}
