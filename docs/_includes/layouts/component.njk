{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% block beforeContent %}
  {% if title === "Components" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/components",
      text: "Components"
    }) }}
  {% endif %}
{% endblock %}

{% set sidebar %}
  {{ appSideNavigation({
    label: 'Components',
    currentPath: page.url,
    sections: [
      {
        heading: {
          text: 'Components'
        },
        items: collections.component | sort(attribute="data.title")
      },
      {
        heading: {
          text: 'Archived'
        },
        items: collections.archivedComponent | sort(attribute="data.title")
      }
    ]
  }) }}
{% endset %}

{% block content %}
  {{ heading({
    text: title,
    level: 1,
    size: "xl",
    caption: { text: "Components" } if tags and ("component" in tags or "archivedComponent" in tags) else none,
    classes: "nhsuk-u-margin-bottom-5"
  }) }}
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and "component" in tags %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}

{% endblock %}
