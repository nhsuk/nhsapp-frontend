---
section: web
---

{% extends "./sidebar.njk" %}

{% block sidebar %}
  {{ sectionNavigation({
    ariaLabel: "Components",
    direction: "vertical",
    small: true,
    items: collections.component | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Archived</h3>
  {{ sectionNavigation({
    ariaLabel: "Archived",
    direction: "vertical",
    small: true,
    items: collections.archivedComponent | sort(attribute="data.title") | toSectionNavigationItems(page.url)
  }) }}
{% endblock %}

{% block content %}
   {% if tags and ("component" in tags or "archivedComponent" in tags) %}
    <span class="nhsuk-caption-xl">Components</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and "component" in tags %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}

{% endblock %}
