---
section: web
---

{% extends "./sidebar.njk" %}

{% block sidebar %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Screens</h3>
  {{ sectionNavigation({
    ariaLabel: "Screens",
    direction: "vertical",
    small: true,
    items: collections.screen | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Structure</h3>
  {{ sectionNavigation({
    ariaLabel: "Structure",
    direction: "vertical",
    small: true,
    items: collections.structure | sort(attribute="data.order") | withNestedItems(collections.integratingServices | sort(attribute="data.order"), "/patterns/integrating-services/") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Help users to</h3>
  {{ sectionNavigation({
    ariaLabel: "Help users to",
    direction: "vertical",
    small: true,
    items: collections.helpUsers | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}
{% endblock %}

{% block content %}
  {% if childPage %}
    <span class="nhsuk-caption-xl">Integrating services into the NHS App</span>
  {% elif tags and "screen" in tags %}
    <span class="nhsuk-caption-xl">Screens</span>
  {% elif tags and "structure" in tags %}
    <span class="nhsuk-caption-xl">Structure</span>  
  {% elif tags and "helpUsers" in tags %}
    <span class="nhsuk-caption-xl">Help users to</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  {% if pageNotice %}
    {% include "layouts/partials/" + pageNotice + ".njk" %}
  {% endif %}
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and ("screen" in tags or "helpUsers" in tags or "structure" in tags) %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
