{% extends "./sidebar.njk" %}

{%- from "./partials/side-navigation.njk" import appSideNavigation %}

{% block beforeContent %}
  {% if title === "Patterns" %}
    {{ breadcrumb({
      href: "/",
      text: "Home"
    }) }}
  {% else %}
    {{ breadcrumb({
      items: [
        {
          href: "/",
          text: "Home"
        }
      ],
      href: "/patterns",
      text: "Patterns"
    }) }}
  {% endif %}
{% endblock %}

{% set sidebar %}
  {{ appSideNavigation({
    label: 'Patterns',
    currentPath: page.url,
    sections: [
      {
        heading: {
          text: 'Screens'
        },
        items: collections.screen | sort(attribute="data.order") | withNestedItems(collections.integratingServices | sort(attribute="data.order"), "/patterns/integrating-services/")
      },
            {
        heading: {
          text: 'Structure'
        },
        items: collections.structure | sort(attribute="data.order") | withNestedItems(collections.integratingServices | sort(attribute="data.order"), "/patterns/integrating-services/")
      },
      {
        heading: {
          text: 'Help users to'
        },
        items: collections.helpUsers | sort(attribute="data.order")
      }
    ]
  }) }}
{% endset %}

{% block content %}
  {{ heading({
    text: title,
    level: 1,
    size: "xl",
    caption: { text: "Integrating services into the NHS App" } if childPage else ({ text: "Screens" } if tags and "screen" in tags else ({ text: "Structure" } if tags and "structure" in tags else ({ text: "Help users to" } if tags and "helpUsers" in tags else none))),
    classes: "nhsuk-u-margin-bottom-5"
  }) }}
  {% if pageNotice %}
    {% include "layouts/partials/" + pageNotice + ".njk" %}
  {% endif %}
  <p>{{ description }}</p>
  {{ content | safe }}
  {% if tags and ("screen" in tags or "helpUsers" in tags or "structure" in tags) %}
    {% include "layouts/partials/feedback-section.njk" %}
  {% endif %}
{% endblock %}
