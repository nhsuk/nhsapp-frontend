---
section: community
---

{% extends "./sidebar.njk" %}

{% block sidebar %}
  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Contributing</h3>
  {{ sectionNavigation({
    ariaLabel: "Contributing",
    direction: "vertical",
    small: true,
    items: collections.contribution | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}

  <h3 class="nhsuk-heading-xs nhsuk-u-margin-bottom-1">Support</h3>
  {{ sectionNavigation({
    ariaLabel: "Support",
    direction: "vertical",
    small: true,
    items: collections.community | sort(attribute="data.order") | toSectionNavigationItems(page.url)
  }) }}
{% endblock %}

{% block content %}
  {% if tags and "contribution" in tags %}
    <span class="nhsuk-caption-xl">Contributing</span>
  {% elif tags and "community" in tags %}
    <span class="nhsuk-caption-xl">Support</span>
  {% endif %}
  <h1 class="nhsuk-heading-xl nhsuk-u-margin-bottom-5">
    {{ title }}
  </h1>
  <p>{{ description }}</p>
  {{ content | safe }}
{% endblock %}
