{% extends "layouts/base.njk" %}

{% from 'nhsapp/components/card/macro.njk' import nhsappCardGroup %}
{% from 'nhsapp/components/card/macro.njk' import nhsappCard %}
{% from 'nhsuk/components/hero/macro.njk' import hero as nhsukHero %}
{% from 'nhsuk/components/button/macro.njk' import button as nhsukButton %}

{% block header %}
  {{ super() }}

  {% set heroHtml %}
    <p>Use the NHS App design system alongside the <a href="https://service-manual.nhs.uk/">NHS digital service manual</a>.</p>
    <p>The NHS App design system enables teams to avoid repetition by learning from the work and experiences of others.</p>

    <p>The design system covers web, iOS and Android platforms.</p>
  {% endset %}

  {{ nhsukHero({
    classes: "app-hero",
    content: [
      {
        heading: "Design and build accessible services for the NHS App",
        width: "one-half",
        html: heroHtml
      },
      {
        image: {
          src: "assets/images/hero-image.svg",
          alt: "",
          background: false,
          border: false
        },
        width: "one-half",
        classes: "nhsuk-u-display-none-until-desktop"
      }
    ]
  }) }}
{% endblock %}

{% block main %}
  <main role="main" id="maincontent">
    <section class="nhsuk-main-wrapper app-section app-section--white app-section--with-bottom-border ">
      <div class="nhsuk-width-container">
        <div class="nhsuk-grid-row">
          <div class="nhsuk-grid-column-one-third app-section__column">
            <h2>Web</h2>
            <p>Components, patterns and styles for web-based NHS App screens.</p>
            <p><a href="/web/" class="nhsuk-link--no-visited-state">Browse web design system</a></p>
          </div>
          <div class="nhsuk-grid-column-one-third app-section__column">
            <h2>iOS</h2>
            <p>Styles, components and layouts for native iOS screens.</p>
            <p><a href="/ios/" class="nhsuk-link--no-visited-state">Browse iOS design system</a></p>
          </div>
          <div class="nhsuk-grid-column-one-third app-section__column">
            <h2>Android</h2>
            <p>Styles, components and layouts for native Android screens.</p>
            <p><a href="/android/" class="nhsuk-link--no-visited-state">Browse Android design system</a></p>
          </div>
        </div>
      </div>
    </section>
    <section class="nhsuk-main-wrapper app-section">
      <div class="nhsuk-width-container">
        <div class="nhsuk-grid-row">
          <div class="nhsuk-grid-column-two-thirds">
            <h2>What's new</h2>
            <h3 class="nhsuk-heading-s">27 November 2026</h3>
            <p>We've rearranged the design system into web, iOS and Android sections.</p>
            <h3 class="nhsuk-heading-s">20 November 2026</h3>
            <p>We've released <a href="/ios/version-history/#2.2.0---20-november-2026">version 2.2.0 of the iOS design system</a>. It adds guidance for forms and lists, a plain button style, and a top section background, as well as fixes for toolbar items and long screen titles.</p>
            <h3 class="nhsuk-heading-s">16 November 2026</h3>
            <p>We've added a <a href="/web/components/card-links/#proxy-card-links">proxy colour variation</a> to card links for the web. Use it for the profile card when users are managing health services for someone else. It replaces the proxy banner.</p>     
          </div>
          <div class="nhsuk-grid-column-full">
            <hr class="nhsuk-section-break nhsuk-section-break--l nhsuk-section-break--visible app-section-break nhsuk-u-margin-top-0 app-section-break--width-4">
          </div>
          <div class="nhsuk-grid-column-two-thirds">
            <h2>Contributing</h2>
            <p>Anyone can contribute to the NHS App design system. You can share findings or suggest a change.</p>
            <p class="nhsuk-u-static-margin-bottom-3"><a href="/community/" class="nhsuk-link--no-visited-state">Find out how to contribute</a></p>
          </div>
        </div>
      </div>
    </section>
    <div class="nhsuk-width-container">
      <div class="nhsuk-grid-row">
        <div class="nhsuk-grid-column-full">
          {% include "layouts/partials/propose-change.njk" %}
        </div>
      </div>
    </div>
  </main>

{% endblock main %}

