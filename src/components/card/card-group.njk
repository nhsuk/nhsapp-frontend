{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}
{% set stackedClass = 'nhsapp-cards--stacked' if params.stacked else '' %}
{% set headingLevel = params.headingLevel if params.headingLevel else 2 %}

{#- Support description as string (with deprecated `descriptionHtml` option) #}
{%- set description = params.description if params.description is mapping and params.description is not escaped else {
  text: params.description if params.description is string or params.description is number else undefined,
  html: params.description if params.description is escaped else (undefined if params.description else params.descriptionHtml)
} %}
{%- set heading = params.heading if params.heading is mapping and params.heading is not escaped else {
  text: params.heading if params.heading is string or params.heading is number else undefined,
  html: params.headingHtml
} %}

{% from "./macro.njk" import nhsappCard %}

{%- if heading.html -%}
    {{ nhsukContent(heading) | trim }}
{% elif heading.text %}
  <h{{ headingLevel }} class="nhsapp-cards__heading {{ headingClass }}">
    {{ nhsukContent(heading) | trim }}
  </h{{ headingLevel }}>
{% endif %}

{% if description.html %}
  {{ nhsukContent(description) | trim }}
{% elif description.text %}
  <p class="nhsapp-cards__description {{ descriptionClass }}">
    {{ nhsukContent(description) | trim }}
  </p>
{% endif %}

{# Control whether it renders as a list of <li> inside a <ul>, or plain blocks inside a <div>. Defaults to list (true). #}
{% set isList = params.isListItem if params.isListItem is defined else true %}
{% set wrapperTag = 'ul' if isList else 'div' %}

<{{ wrapperTag }} {%- if params.id %} id="{{ params.id }}"{% endif %} class="nhsapp-cards {{ stackedClass }} {{ params.classes if params.classes }}" {{- nhsukAttributes(params.attributes) }}>
  {% for cardItem in params.cards %}
    {{ nhsappCard({
      title: cardItem.title,
      titleHtml: cardItem.titleHtml,
      titleClasses: cardItem.titleClasses,
      headingLevel: cardItem.headingLevel,
      href: cardItem.href,
      html: cardItem.html,
      classes: cardItem.classes,
      containerClasses: cardItem.containerClasses,
      aboveContent: cardItem.aboveContent,
      description: cardItem.description,
      descriptionHtml: cardItem.descriptionHtml,
      descriptionClasses: cardItem.descriptionClasses,
      badgeLarge: cardItem.badgeLarge,
      img: cardItem.img,
      footer: cardItem.footer,
      isListItem: isList,
      linkAriaLabel: cardItem.linkAriaLabel
    }) }}
  {% endfor %}
</{{ wrapperTag }}>