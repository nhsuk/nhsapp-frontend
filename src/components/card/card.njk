{% from "nhsuk/components/heading/macro.njk" import heading as nhsukHeading %}
{% from "nhsuk/components/link/macro.njk" import link as nhsukLink %}
{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}
{% from "../badge/large/macro.njk" import nhsappBadgeLarge %}
{% from "../../styles/icon/macro.njk" import nhsappIcon %}

{# Safe defaults for nested objects #}
{% set above = params.aboveContent if params.aboveContent is defined else {} %}
{% set footer = params.footer if params.footer is defined else {} %}
{% set badge = params.badgeLarge if params.badgeLarge is defined else {} %}
{% set badgeCount = badge.count if badge.count is defined else 0 %}
{% set hasBadgeLarge = badgeCount > 0 %}

{#- Support heading as a string or object, with deprecated `title`, `titleHtml`, `titleClasses`, `headingLevel` and `headingHtml` options #}
{%- set legacyTitle = params.title if params.title is mapping and params.title is not escaped else {
  text: params.title if params.title is string or params.title is number else undefined,
  html: params.title if params.title is escaped else params.titleHtml
} %}
{%- set headingParam = params.heading if params.heading is mapping and params.heading is not escaped else {
  text: params.heading if params.heading is string or params.heading is number else undefined,
  html: params.heading if params.heading is escaped else params.headingHtml
} %}
{%- set hasHeadingParam = headingParam.text or headingParam.html %}
{%- set heading = {
  text: headingParam.text if hasHeadingParam else legacyTitle.text,
  html: headingParam.html if hasHeadingParam else legacyTitle.html,
  level: headingParam.level or params.headingLevel,
  classes: headingParam.classes or legacyTitle.classes or params.titleClasses,
  size: headingParam.size,
  id: headingParam.id
} %}
{%- set headingSizes = ["xxs", "xs", "s", "m", "l", "xl"] %}
{%- set headingClasses = ((("nhsuk-heading-" ~ heading.size) if heading.size in headingSizes else "") ~ " " ~ (heading.classes or "")) | trim %}

{#- Support description as string (with deprecated `descriptionHtml` option) #}
{%- set description = params.description if params.description is mapping and params.description is not escaped else {
  text: params.description if params.description is string or params.description is number else undefined,
  html: params.description if params.description is escaped else (undefined if params.description else params.descriptionHtml)
} %}
{% set descriptionClasses = description.classes if description.classes is defined else params.descriptionClasses %}

{% set hasMedia = params.img is defined and params.img.src is defined %}
{% set imgAlt = params.img.alt if params.img.alt is defined else '' %}

{# Wrapper tag #}
{% set isListItem = params.isListItem if params.isListItem is defined else false %}
{% set wrapperTag = 'li' if isListItem else 'div' %}

<{{ wrapperTag }} {%- if params.id %} id="{{ params.id }}"{% endif %} class="nhsapp-card {{ 'nhsapp-card--with-media' if hasMedia }} {{ params.classes if params.classes }}" {{- nhsukAttributes(params.attributes) }}>

  {% if hasMedia %}
  <div class="nhsapp-card__media">
    <img class="nhsapp-card__img" src="{{ params.img.src }}" alt="{{ params.img.alt }}">
  </div>
  {% endif %}
  
  <div class="nhsapp-card__container {{ params.containerClasses if params.containerClasses }}">
    <div class="nhsapp-card__content">
      
      {%- if above.html or above.text -%}
        <div class="nhsapp-card__above">
          {{ nhsukContent(above) | trim }}
        </div>
      {%- endif -%}

      {%- if params.href -%}
        {{ nhsukLink({
          href: params.href,
          text: heading.text,
          html: heading.html,
          id: heading.id,
          ariaLabel: params.linkAriaLabel,
          className: "nhsapp-card__link",
          classes: ("nhsuk-link--no-visited-state " ~ headingClasses) | trim
        }) | trim }}
      {%- else -%}
        {{ nhsukHeading({
          text: heading.text,
          html: heading.html,
          id: heading.id,
          size: heading.size,
          level: heading.level,
          element: undefined if heading.level else "p",
          classes: heading.classes,
          className: "nhsapp-card__heading",
          classPrefix: "nhsuk-heading-"
        }) | trim }}
      {%- endif -%}

      {% if description.html %}
        {{ nhsukContent(description) | trim }}
      {% elif description.text %}
        <div class="nhsapp-card__below">
          <p class="nhsapp-card__description {{ descriptionClasses if descriptionClasses }}">{{ nhsukContent(description) | trim }}</p>
        </div>
      {% endif %}
    </div>

    {% if hasBadgeLarge %}
      {{ nhsappBadgeLarge({
        count: badgeCount,
        label: badge.label if badge.label is defined,
        id: badge.id if badge.id is defined,
        classes: badge.classes if badge.classes is defined,
        attributes: badge.attributes if badge.attributes is defined
      }) }}
    {% endif %}

    {%- if params.href -%}
      {{ nhsappIcon('chevronRight') }}
    {%- endif -%}
  </div>

  {%- if footer.html or footer.text -%}
    <div class="nhsapp-card__footer">
      {{ nhsukContent(footer) | trim }}
    </div>
  {%- endif -%}
</{{ wrapperTag }}>
