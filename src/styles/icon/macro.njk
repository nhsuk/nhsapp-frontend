{% from "nhsuk/macros/attributes.njk" import nhsukAttributes %}

{#-
  Renders an inline SVG icon

  @param {string} name - Icon name in kebab-case (`chevron-right`) or camelCase (`chevronRight`)
  @param {object|string} [params] - Icon params. Passing a string of classes is deprecated, use `params.classes` instead
  @param {string} [params.classes] - Classes to add to the icon
  @param {string} [params.title] - Accessible name. Without it the icon is hidden from assistive technologies
  @param {number} [params.size] - Icon size adjustment in percent (25, 50, 75, 100)
  @param {string} [params.html] - HTML for the SVG content, used instead of the named icon
  @param {object} [params.attributes] - HTML attributes to add to the icon
  @param {string} [iconName] - Deprecated, use `name` instead. Only works as a keyword argument, for example `nhsappIcon(iconName="tick")`
  @param {string} [classes] - Deprecated, use `params.classes` instead. Only works as a keyword argument, for example `nhsappIcon("tick", classes="x")`
#}
{% macro nhsappIcon(name, params = {}, iconName = undefined, classes = undefined) %}
  {%- set options = { classes: params } if params is string else params -%}
  {%- if classes and not options.classes -%}
    {%- set options = { classes: classes, title: options.title, size: options.size, html: options.html, attributes: options.attributes } -%}
  {%- endif -%}
  {%- set name = (name or iconName) | replace(r/([A-Z])/g, "-$1") | lower -%}
  {%- set classNames = "nhsapp-icon nhsapp-icon--" ~ name -%}

  {%- if options.size and options.size | string in ["25", "50", "75", "100"] and "nhsapp-icon--size-" not in (options.classes or "") -%}
    {%- set classNames = classNames ~ " nhsapp-icon--size-" ~ options.size -%}
  {%- endif -%}

  {%- if options.classes -%}
    {%- set classNames = classNames ~ " " ~ options.classes -%}
  {%- endif -%}

<svg
  {{- nhsukAttributes({
    class: classNames,
    xmlns: "http://www.w3.org/2000/svg",
    viewBox: "0 0 24 24",
    width: "2rem",
    height: "2rem",
    focusable: "false",
    role: {
      value: "img" if options.title else false,
      optional: true
    },
    "aria-label": {
      value: options.title if options.title else false,
      optional: true
    },
    "aria-hidden": {
      value: false if options.title else "true",
      optional: true
    }
  }) -}}

  {{- nhsukAttributes(options.attributes) }}>
{% if options.title %}
  <title>{{ options.title }}</title>
{% endif %}
{% if options.html %}
  {{ options.html | safe | trim | indent(2) }}
